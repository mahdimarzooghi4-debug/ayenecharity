NODE_ENV=development

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# API
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ayenecharity
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12

# One-time bootstrap. Do not keep a real password in committed files.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# S3-compatible object storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional CDN/base URL for PUBLIC project and hero images.
# Example: https://media.example.org
PUBLIC_MEDIA_BASE_URL=

# Private signed download URLs are intentionally short-lived.
MEDIA_SIGNED_URL_TTL_SECONDS=300
