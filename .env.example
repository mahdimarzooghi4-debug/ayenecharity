NODE_ENV=development

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Set only when the API is behind a trusted reverse proxy/load balancer.
# Example for one trusted proxy hop: TRUST_PROXY_HOPS=1
TRUST_PROXY_HOPS=0

# API
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ayenecharity
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12

# One-time bootstrap. Do not keep a real password in committed files.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# S3-compatible object storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional CDN/base URL for PUBLIC project and hero images.
# Example: https://media.example.org
PUBLIC_MEDIA_BASE_URL=

# Private signed download URLs are intentionally short-lived.
MEDIA_SIGNED_URL_TTL_SECONDS=300


# Production security notes:
# - provision DATABASE_URL and SESSION_SECRET through the deployment secret store
# - never reuse the development database credentials in production
# - WEB_ORIGIN must be HTTPS in production (comma-separated origins are supported)
# - S3 credentials may be omitted when the runtime uses workload/instance credentials
