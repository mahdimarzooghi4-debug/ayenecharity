{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./.e2e-dist",
    "rootDir": "./src",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".e2e-dist",
    "src/**/*.spec.ts"
  ]
}
