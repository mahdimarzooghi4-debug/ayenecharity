# Copy to /opt/ayenecharity-staging/.env.staging on the server.
# Never commit the real values.

POSTGRES_DB=ayenecharity_stage
POSTGRES_USER=ayenecharity_stage
POSTGRES_PASSWORD=replace-with-a-long-random-password

SESSION_SECRET=replace-with-at-least-32-random-characters

MINIO_ROOT_USER=ayenecharitystage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_BUCKET=ayenecharity-stage
