# Copy to /opt/ayenecharity-production/.env.production on the server.
# Replace every placeholder. Never commit the real file.

POSTGRES_DB=ayenecharity
POSTGRES_USER=ayenecharity
POSTGRES_PASSWORD=replace-with-a-long-random-password

SESSION_SECRET=replace-with-at-least-32-random-characters

MINIO_ROOT_USER=ayenecharityprod
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_BUCKET=ayenecharity

# Canonical production origins.
SITE_URL=https://ayenecharity.ir
WEB_ORIGIN=https://ayenecharity.ir,https://www.ayenecharity.ir
API_ORIGIN=https://api.ayenecharity.ir
API_HOST=api.ayenecharity.ir

# Host-loopback ports. Keep these different from staging and existing services.
WEB_HOST_PORT=3300
API_HOST_PORT=3301
OBJECT_STORAGE_API_HOST_PORT=9300
OBJECT_STORAGE_CONSOLE_HOST_PORT=9301
